# Claude API key — powers the AI perfume lookup fallback and the marketing
# content generator. The app still works without it (dataset-only matching).
ANTHROPIC_API_KEY=

# WooCommerce store connection (WooCommerce > Settings > Advanced > REST API,
# create a key with Read permission).
WOO_URL=https://your-store.example.com
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# Password for the /admin area (marketing team).
ADMIN_PASSWORD=change-me
